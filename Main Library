        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = ACCENT,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Visible = false,
        Active = true,
        ZIndex = 110
    }, PageHolder)

    local pageLayout = New("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, page)

    tabData.Button = tabButton
    tabData.Page = page
    tabData.Sections = {}

    function tabData:AddSection(name, open)
        local section = CreateSection(tabData, name, open)

        table.insert(tabData.Sections, section)

        return section
    end

    function tabData:GetSection(name)
        for _, section in ipairs(tabData.Sections) do
            if section.Name == name then
                return section
            end
        end

        return tabData.Sections[1]
    end

    tabButton.Activated:Connect(function()
        SelectTab(tabData)
    end)

    table.insert(tabs, tabData)

    if not currentTab then
        SelectTab(tabData)
    end

    return tabData
end

