--==================================================
-- 5 SECOND LOADING
--==================================================

task.spawn(function()
    local duration = 5
    local start = os.clock()

    while true do
        local elapsed = os.clock() - start
        local progress = math.clamp(elapsed / duration, 0, 1)
        local percent = math.floor(progress * 100)

        LoadingBar.Size = UDim2.new(progress, 0, 1, 0)
        LoadingStatus.Text = "Loading... " .. percent .. "%"

        if progress >= 1 then
            break
        end

        task.wait()
    end

    LoadingStatus.Text = "Loaded!"

    task.wait(0.25)

    local fadeInfo = TweenInfo.new(
        0.35,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )

    Tween(LoadingBackground, fadeInfo, {
        BackgroundTransparency = 1
    })

    Tween(LoadingPanel, fadeInfo, {
        BackgroundTransparency = 1
    })

    Tween(LoadingLogo, fadeInfo, {
        ImageTransparency = 1
    })

    Tween(LoadingTitle, fadeInfo, {
        TextTransparency = 1
    })

    Tween(LoadingDiscord, fadeInfo, {
        TextTransparency = 1
    })

    Tween(LoadingStatus, fadeInfo, {
        TextTransparency = 1
    })

    Tween(LoadingBarBack, fadeInfo, {
        BackgroundTransparency = 1
    })

    Tween(LoadingBar, fadeInfo, {
        BackgroundTransparency = 1
    })

    task.wait(0.4)

    if LoadingGui then
        LoadingGui:Destroy()
    end
end)

