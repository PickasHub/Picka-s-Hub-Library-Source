    --==================================================
    -- SELECT
    --==================================================

    local function Select()

        for _, Existing in ipairs(Tabs) do

            Existing.Page.Visible = false

            Existing.Button.BackgroundTransparency = 1

            local ExistingText =
                Existing.Button:FindFirstChildOfClass(
                    "TextLabel"
                )

            if ExistingText then
                ExistingText.TextColor3 = MUTED
            end

            local ExistingIcon =
                Existing.Button:FindFirstChild("Icon")

            if ExistingIcon then
                ExistingIcon.ImageColor3 = MUTED
            end

        end

        Page.Visible = true

        TabButton.BackgroundTransparency = 0

        Tween(TabButton, 0.15, {
            BackgroundColor3 = ACCENT
        })

        TabText.TextColor3 =
            Color3.fromRGB(
                255,
                255,
                255
            )

        if Icon then
            Icon.ImageColor3 =
                Color3.fromRGB(
                    255,
                    255,
                    255
                )
        end

        CurrentTab = Tab

    end

