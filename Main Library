local tabs = {}
local currentTab = nil

local function SelectTab(tabData)
    for _, data in ipairs(tabs) do
        if data.Button then
            if data == tabData then
                data.Button.BackgroundColor3 = ACCENT
                data.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                data.Button.BackgroundColor3 = BUTTON
                data.Button.TextColor3 = TEXT
            end
        end

        if data.Page then
            data.Page.Visible = (data == tabData)
        end
    end

    currentTab = tabData
end

