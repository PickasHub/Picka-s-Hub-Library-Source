--========================================================
-- LOADING ANIMATION
--========================================================

task.spawn(function()

	MainGui.DisplayOrder =
		HUB_DISPLAY_ORDER

	LoadingGui.DisplayOrder =
		LOADING_DISPLAY_ORDER

	MainWindow.Visible = true

	MainWindow.Size =
		UDim2.fromOffset(
			1,
			1
		)

	local states = {

		"Initializing...",
		"Loading interface...",
		"Loading components...",
		"Preparing tabs...",
		"Applying theme...",
		"Almost ready..."

	}

	local duration = 5

	local startTime =
		os.clock()

	while true do

		local elapsed =
			os.clock() -
			startTime

		local progress =
			math.clamp(
				elapsed /
					duration,
				0,
				1
			)

		ProgressFill.Size =
			UDim2.new(
				progress,
				0,
				1,
				0
			)

		Percentage.Text =
			tostring(
				math.floor(
					progress * 100
				)
			) .. "%"

		local stateIndex =
			math.clamp(

				math.floor(
					progress *
						#states
				) + 1,

				1,
				#states

			)

		LoadingStatus.Text =
			states[stateIndex]

		if progress >= 1 then
			break
		end

		task.wait()

	end

	LoadingStatus.Text =
		"Loaded successfully"

	Percentage.Text =
		"100%"

	ProgressFill.Size =
		UDim2.new(
			1,
			0,
			1,
			0
		)

	task.wait(0.25)

	MainWindow.Visible = true

	MainWindow.Size =
		UDim2.fromOffset(
			1,
			1
		)

	PlayTween(

		MainWindow,

		0.45,

		{
			Size =
				CurrentNormalSize
		},

		Enum.EasingStyle.Back,

		Enum.EasingDirection.Out

	)

	task.wait(0.25)

	PlayTween(

		LoadingPanel,

		0.35,

		{
			BackgroundTransparency = 1
		}

	)

	PlayTween(

		LoadingBlocker,

		0.4,

		{
			BackgroundTransparency = 1
		}

	)

	for _, object in ipairs(
		LoadingPanel:GetDescendants()
	) do

		if object:IsA("TextLabel") then

			PlayTween(

				object,

				0.3,

				{
					TextTransparency = 1
				}

			)

		elseif object:IsA("ImageLabel") then

			PlayTween(

				object,

				0.3,

				{
					ImageTransparency = 1
				}

			)

		elseif object:IsA("Frame")
			and object ~= LoadingPanel then

			PlayTween(

				object,

				0.3,

				{
					BackgroundTransparency = 1
				}

			)

		end

	end

	task.wait(0.45)

	if LoadingGui then
		LoadingGui:Destroy()
	end

end)

