--==================================================
-- DRAG SYSTEM
--==================================================

local draggingWindow = false
local draggingFloating = false
local resizingWindow = false

local windowDragStart = nil
local windowStartPosition = nil

local floatingDragStart = nil
local floatingStartPosition = nil

local resizeStart = nil
local resizeStartSize = nil
local resizeStartPosition = nil

-- WINDOW DRAG
local function StartWindowDrag(input)
    if resizingWindow or draggingFloating then
        return
    end

    draggingWindow = true
    windowDragStart = input.Position
    windowStartPosition = MainWindow.Position
end

local function StopWindowDrag()
    draggingWindow = false
end

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        -- Don't drag when clicking controls
        if input.Target == MinimizeButton
            or input.Target == CloseButton then
            return
        end

        StartWindowDrag(input)
    end
end)

-- FLOATING LOGO DRAG
FloatingLogo.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        if not FloatingLogo.Visible then
            return
        end

        draggingFloating = true
        floatingDragStart = input.Position
        floatingStartPosition = FloatingLogo.Position
    end
end)

-- RESIZE
ResizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        resizingWindow = true
        resizeStart = input.Position
        resizeStartSize = MainWindow.AbsoluteSize
        resizeStartPosition = MainWindow.Position
    end
end)

--==================================================
-- GLOBAL INPUT MOVEMENT
--==================================================

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    -- Window drag
    if draggingWindow and windowDragStart and windowStartPosition then
        local delta = input.Position - windowDragStart

        MainWindow.Position = UDim2.new(
            windowStartPosition.X.Scale,
            windowStartPosition.X.Offset + delta.X,
            windowStartPosition.Y.Scale,
            windowStartPosition.Y.Offset + delta.Y
        )

    -- Floating logo drag
    elseif draggingFloating and floatingDragStart and floatingStartPosition then
        local delta = input.Position - floatingDragStart

        FloatingLogo.Position = UDim2.new(
            floatingStartPosition.X.Scale,
            floatingStartPosition.X.Offset + delta.X,
            floatingStartPosition.Y.Scale,
            floatingStartPosition.Y.Offset + delta.Y
        )

    -- Window resize
    elseif resizingWindow and resizeStart and resizeStartSize then
        local delta = input.Position - resizeStart

        local newWidth = math.clamp(
            resizeStartSize.X + delta.X,
            MIN_WIDTH,
            MAX_WIDTH
        )

        local newHeight = math.clamp(
            resizeStartSize.Y + delta.Y,
            MIN_HEIGHT,
            MAX_HEIGHT
        )

        MainWindow.Size = UDim2.fromOffset(
            newWidth,
            newHeight
        )
    end
end)

--==================================================
-- INPUT END
--==================================================

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingWindow = false
        draggingFloating = false
        resizingWindow = false

        windowDragStart = nil
        floatingDragStart = nil
        resizeStart = nil
    end
end)

--==================================================
-- OPEN / CLOSE ANIMATION
--==================================================

local windowOpenSize = WINDOW_SIZE

local function ShowWindow()
    if MainWindow.Visible then
        return
    end

    MainWindow.Visible = true
    FloatingLogo.Visible = false

    MainWindow.Size = UDim2.fromOffset(0, 0)

    Tween(
        MainWindow,
        TweenInfo.new(
            0.28,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {
            Size = windowOpenSize
        }
    )
end

local function HideWindow()
    if not MainWindow.Visible then
        return
    end

    local currentSize = MainWindow.Size

    Tween(
        MainWindow,
        TweenInfo.new(
            0.22,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.In
        ),
        {
            Size = UDim2.fromOffset(0, 0)
        }
    ).Completed:Connect(function()
        MainWindow.Visible = false
        MainWindow.Size = currentSize

        FloatingLogo.Size = UDim2.fromOffset(0, 0)
        FloatingLogo.ImageTransparency = 1
        FloatingLogo.Visible = true

        Tween(
            FloatingLogo,
            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            ),
            {
                Size = UDim2.fromOffset(44, 44),
                ImageTransparency = 0
            }
        )
    end)
end

FloatingLogo.MouseButton1Click:Connect(function()
    if draggingFloating then
        return
    end

    FloatingLogo.Visible = false
    FloatingLogo.Size = UDim2.fromOffset(0, 0)
    FloatingLogo.ImageTransparency = 1

    MainWindow.Visible = true
    MainWindow.Size = UDim2.fromOffset(0, 0)

    Tween(
        MainWindow,
        TweenInfo.new(
            0.28,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {
            Size = windowOpenSize
        }
    )
end)

CloseButton.MouseButton1Click:Connect(function()
    HideWindow()
end)

MinimizeButton.MouseButton1Click:Connect(function()
    HideWindow()
end)

