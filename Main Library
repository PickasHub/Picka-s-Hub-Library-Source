                    Position =
                        UDim2.fromOffset(
                            20,
                            2
                        )
                })

            else

                Tween(Switch, 0.15, {
                    BackgroundColor3 =
                        Color3.fromRGB(
                            60,
                            45,
                            65
                        )
                })

                Tween(Knob, 0.15, {
                    Position =
                        UDim2.fromOffset(
                            2,
                            2
                        )
                })

            end

        end

        Toggle.MouseButton1Click:Connect(function()

            State = not State

            Update()

            if typeof(Data.Callback) ==
                "function" then

                task.spawn(
                    Data.Callback,
                    State
                )

            end

        end)

        Update()

        return {

            SetValue = function(_, Value)

                State = Value == true

                Update()

                if typeof(Data.Callback) ==
                    "function" then

                    task.spawn(
                        Data.Callback,
                        State
                    )

                end

            end,

            GetValue = function()

                return State

            end

        }

    end

