--========================================================
-- CREATE WINDOW
--========================================================

function Library:CreateWindow(config)

	config = config or {}

	if config.Title then

		Title.Text =
			tostring(
				config.Title
			)

	end

	if config.Description then

		Description.Text =
			tostring(
				config.Description
			)

	end

	if config["Tab Width"] then

		local width =
			tonumber(
				config["Tab Width"]
			)

		if width then

			for _, tab in ipairs(Tabs) do

				tab.Button.Size =
					UDim2.fromOffset(
						width,
						30
					)

			end

		end

	end

	return Library

end

--========================================================
-- WINDOW PUBLIC FUNCTIONS
--========================================================

function Library:Open()

	OpenWindow()

end

function Library:Close()

	CloseWindow()

end

function Library:Toggle()

	if WindowOpen then

		CloseWindow()

	else

		OpenWindow()

	end

end

function Library:SetSize(
	width,
	height
)

	width =
		math.clamp(

			tonumber(width)
				or DEFAULT_WIDTH,

			MIN_WIDTH,
			MAX_WIDTH

		)

	height =
		math.clamp(

			tonumber(height)
				or DEFAULT_HEIGHT,

			MIN_HEIGHT,
			MAX_HEIGHT

		)

	CurrentNormalSize =
		UDim2.fromOffset(
			width,
			height
		)

	if WindowOpen then

		MainWindow.Size =
			CurrentNormalSize

	end

end

