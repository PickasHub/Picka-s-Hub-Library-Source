            or "Dropdown"

        DropTitle.TextColor3 = TEXT
        DropTitle.TextSize = 12

        DropTitle.TextXAlignment =
            Enum.TextXAlignment.Left

        DropTitle.Parent =
            DropdownButton

        local SelectedText =
            Instance.new("TextLabel")

        SelectedText.BackgroundTransparency = 1

        SelectedText.Position =
            UDim2.fromOffset(10, 24)

        SelectedText.Size =
            UDim2.new(1, -20, 0, 18)

        SelectedText.Font =
            Enum.Font.Gotham

        SelectedText.Text =
            tostring(
                Selected
                or "Select..."
            )

        SelectedText.TextColor3 = MUTED
        SelectedText.TextSize = 9

        SelectedText.TextXAlignment =
            Enum.TextXAlignment.Left

        SelectedText.Parent =
            DropdownButton

        local OptionFrame =
            Instance.new("Frame")

        OptionFrame.Name = "Options"

        OptionFrame.Position =
            UDim2.new(
                0,
                0,
                1,
                4
            )

        OptionFrame.Size =
            UDim2.new(
                1,
                0,
                0,
                0
            )

        OptionFrame.BackgroundColor3 =
            BACKGROUND

        OptionFrame.BorderSizePixel = 0

        OptionFrame.Visible = false

        OptionFrame.ZIndex = 50

        OptionFrame.Parent = Frame

        Corner(OptionFrame, 7)

        Stroke(
            OptionFrame,
            ACCENT,
            1,
            0.35
        )

        Padding(
            OptionFrame,
            5,
            5,
            5,
            5
        )

        local OptionLayout =
            Instance.new("UIListLayout")

        OptionLayout.Padding =
            UDim.new(0, 3)

        OptionLayout.Parent =
            OptionFrame

        local function SelectOption(Value)

            Selected = Value

            SelectedText.Text =
                tostring(Value)

            if typeof(Data.Callback) ==
                "function" then

                task.spawn(
                    Data.Callback,
                    Value
                )

            end

            Open = false

            OptionFrame.Visible = false

            OptionFrame.Size =
                UDim2.new(
                    1,
                    0,
                    0,
                    0
                )

        end

        for _, Value in ipairs(Options) do

            local Option =
                Instance.new("TextButton")

            Option.Size =
                UDim2.new(
                    1,
                    0,
                    0,
                    28
                )

            Option.BackgroundColor3 = BUTTON

            Option.BorderSizePixel = 0

            Option.AutoButtonColor = false

            Option.Text = tostring(Value)

            Option.TextColor3 = TEXT
            Option.TextSize = 10

            Option.Font = Enum.Font.Gotham

            Option.ZIndex = 51

            Option.Parent = OptionFrame

            Corner(Option, 5)

            Option.MouseButton1Click:Connect(function()

                SelectOption(Value)

            end)

        end

        DropdownButton.MouseButton1Click:Connect(function()

            Open = not Open

            if Open then

                OptionFrame.Visible = true

                local Height =
                    math.min(
                        170,
                        (#Options * 31) + 10
                    )

                Tween(
                    OptionFrame,
                    0.15,
                    {
                        Size =
                            UDim2.new(
                                1,
                                0,
                                0,
                                Height
                            )
                    }
                )

            else

                Tween(
                    OptionFrame,
                    0.15,
                    {
                        Size =
                            UDim2.new(
                                1,
                                0,
                                0,
                                0
                            )
                    }
                )

                task.delay(
                    0.15,
                    function()

                        if not Open then
                            OptionFrame.Visible = false
                        end

                    end
                )

            end

        end)

        return {

            SetValue = function(_, Value)

                SelectOption(Value)

            end,

            GetValue = function()

                return Selected

            end

        }

    end

    --==================================================
