--========================================================
-- FLOATING LOGO DRAG SYSTEM
--========================================================
-- This is the ONLY main behavior changed.
--
-- Tap/click = Open Window
-- Drag = Move Floating Logo
-- Works with Mouse + Touch
-- Small movement does not count as drag.

local floatingDragging = false
local floatingMoved = false

local floatingDragStart = nil
local floatingStartPosition = nil

local FLOAT_DRAG_THRESHOLD = 8

FloatingLogo.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1

		or input.UserInputType ==
		Enum.UserInputType.Touch then

		if Animating then
			return
		end

		floatingDragging = true
		floatingMoved = false

		floatingDragStart =
			input.Position

		floatingStartPosition =
			FloatingLogo.Position

	end

end)

UserInputService.InputChanged:Connect(function(input)

	if not floatingDragging then
		return
	end

	if input.UserInputType ~=
		Enum.UserInputType.MouseMovement

		and input.UserInputType ~=
		Enum.UserInputType.Touch then

		return
	end

	local delta =
		input.Position - floatingDragStart

	if math.abs(delta.X) >
		FLOAT_DRAG_THRESHOLD

		or math.abs(delta.Y) >
		FLOAT_DRAG_THRESHOLD then

		floatingMoved = true

	end

	FloatingLogo.Position =
		UDim2.new(

			floatingStartPosition.X.Scale,

			floatingStartPosition.X.Offset
				+ delta.X,

			floatingStartPosition.Y.Scale,

			floatingStartPosition.Y.Offset
				+ delta.Y

		)

end)

UserInputService.InputEnded:Connect(function(input)

	if input.UserInputType ~=
		Enum.UserInputType.MouseButton1

		and input.UserInputType ~=
		Enum.UserInputType.Touch then

		return
	end

	if not floatingDragging then
		return
	end

	local wasMoved =
		floatingMoved

	floatingDragging = false
	floatingMoved = false

	floatingDragStart = nil
	floatingStartPosition = nil

	-- Tap/click only.
	-- If the user dragged, don't open the window.

	if not wasMoved
		and not Animating
		and not WindowOpen then

		task.defer(function()

			if OpenWindow then
				OpenWindow()
			end

		end)

	end

end)

--========================================================
-- WINDOW ANIMATION
--========================================================

OpenWindow = function()

	if Animating or WindowOpen then
		return
	end

	Animating = true

	FloatingLogo.Active = false

	-- Shrink floating logo.

	local floatingTween =
		PlayTween(

			FloatingLogo,

			0.16,

			{
				Size =
					UDim2.fromOffset(1, 1),

				ImageTransparency = 1
			},

			Enum.EasingStyle.Quart,

			Enum.EasingDirection.Out

		)

	floatingTween.Completed:Wait()

	FloatingLogo.Visible = false

	-- Restore window.

	MainWindow.Visible = true

	MainWindow.Size =
		UDim2.fromOffset(1, 1)

	local windowTween =
		PlayTween(

			MainWindow,

			0.4,

			{
				Size =
					CurrentNormalSize
			},

			Enum.EasingStyle.Back,

			Enum.EasingDirection.Out

		)

	windowTween.Completed:Wait()

	WindowOpen = true
	Animating = false

	FloatingLogo.Active = true

end

CloseWindow = function()

	if Animating or not WindowOpen then
		return
	end

	Animating = true

	CurrentNormalSize =
		MainWindow.Size

	WindowOpen = false

	-- Shrink window.

	local windowTween =
		PlayTween(

			MainWindow,

			0.28,

			{
				Size =
					UDim2.fromOffset(1, 1)
			},

			Enum.EasingStyle.Back,

			Enum.EasingDirection.In

		)

	windowTween.Completed:Wait()

	MainWindow.Visible = false

	-- Show floating logo.

	FloatingLogo.Visible = true

	FloatingLogo.Active = false

	FloatingLogo.Size =
		UDim2.fromOffset(1, 1)

	FloatingLogo.ImageTransparency = 1

	local floatingTween =
		PlayTween(

			FloatingLogo,

			0.3,

			{
				Size =
					UDim2.fromOffset(44, 44),

				ImageTransparency = 0
			},

			Enum.EasingStyle.Back,

			Enum.EasingDirection.Out

		)

	floatingTween.Completed:Wait()

	Animating = false

	FloatingLogo.Active = true

end

