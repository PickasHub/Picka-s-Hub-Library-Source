            ZIndex = 126
        }, SliderFrame)

        local Bar = New("Frame", {
            Position = UDim2.fromOffset(12, 32),
            Size = UDim2.new(1, -24, 0, 7),
            BackgroundColor3 = Color3.fromRGB(55, 40, 60),
            BorderSizePixel = 0,
            Active = true,
            ZIndex = 126
        }, SliderFrame)

        Corner(Bar, 4)

        local Fill = New("Frame", {
            Size = UDim2.new(
                math.clamp((current - min) / math.max(max - min, 1), 0, 1),
                0,
                1,
                0
            ),
            BackgroundColor3 = ACCENT,
            BorderSizePixel = 0,
            ZIndex = 127
        }, Bar)

        Corner(Fill, 4)

        local function SetValue(value)
            current = math.clamp(value, min, max)

            local percent = math.clamp(
                (current - min) / math.max(max - min, 1),
                0,
                1
            )

            Fill.Size = UDim2.new(percent, 0, 1, 0)
            ValueLabel.Text = tostring(math.floor(current * 100) / 100)

            if typeof(data.Callback) == "function" then
                task.spawn(data.Callback, current)
            end
        end

        Bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then

                local connection

                connection = UserInputService.InputChanged:Connect(function(move)
                    if move.UserInputType ~= Enum.UserInputType.MouseMovement
                        and move.UserInputType ~= Enum.UserInputType.Touch then
                        return
                    end

                    local percent = math.clamp(
                        (move.Position.X - Bar.AbsolutePosition.X)
                        / Bar.AbsoluteSize.X,
                        0,
                        1
                    )

                    SetValue(
                        min + (max - min) * percent
                    )
                end)

                local ended
                ended = UserInputService.InputEnded:Connect(function(endInput)
                    if endInput.UserInputType == Enum.UserInputType.MouseButton1
                        or endInput.UserInputType == Enum.UserInputType.Touch then

                        connection:Disconnect()
                        ended:Disconnect()
                    end
                end)
            end
        end)

        SetValue(current)

        return SliderFrame
    end

    function SectionObject:AddParagraph(data)
        data = data or {}

        local Paragraph = New("Frame", {
            Size = UDim2.new(1, 0, 0, 60),
            BackgroundColor3 = BUTTON,
            BorderSizePixel = 0,
            ZIndex = 125
        }, Container)

        Corner(Paragraph, 9)

        local ParagraphTitle = New("TextLabel", {
            Position = UDim2.fromOffset(12, 6),
            Size = UDim2.new(1, -24, 0, 18),
            BackgroundTransparency = 1,
            Text = tostring(data.Title or ""),
            TextColor3 = TEXT,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 126
        }, Paragraph)

        local ParagraphContent = New("TextLabel", {
            Position = UDim2.fromOffset(12, 25),
            Size = UDim2.new(1, -24, 0, 28),
            BackgroundTransparency = 1,
            Text = tostring(data.Content or ""),
            TextColor3 = Color3.fromRGB(175, 155, 190),
            TextSize = 10,
            Font = Enum.Font.Gotham,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            ZIndex = 126
        }, Paragraph)

        return Paragraph
    end

    function SectionObject:AddSeparator()
        return New("Frame", {
            Size = UDim2.new(1, 0, 0, 1),
            BackgroundColor3 = ACCENT,
            BackgroundTransparency = 0.65,
            BorderSizePixel = 0,
            ZIndex = 125
        }, Container)
    end

    return SectionObject
end

