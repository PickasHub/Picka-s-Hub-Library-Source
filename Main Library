    -- DROPDOWN
    --==================================================

    function Tab:AddDropdown(Data)
        Data = Data or {}

        local Options = Data.Options or {}
        local Selected = Data.Default

        if type(Selected) == "table" then
            Selected = Selected[1]
        end

        local Open = false

        local Frame = Instance.new("Frame")
        Frame.Size = UDim2.new(1, 0, 0, 52)
        Frame.BackgroundColor3 = BUTTON
        Frame.BorderSizePixel = 0
        Frame.ClipsDescendants = false
        Frame.Parent = Page

        Corner(Frame, 7)

        local DropdownButton = Instance.new("TextButton")
        DropdownButton.Size = UDim2.fromScale(1, 1)
        DropdownButton.BackgroundTransparency = 1
        DropdownButton.BorderSizePixel = 0
        DropdownButton.AutoButtonColor = false
        DropdownButton.Text = ""
        DropdownButton.Parent = Frame

        local DropTitle = Instance.new("TextLabel")
        DropTitle.BackgroundTransparency = 1
        DropTitle.Position = UDim2.fromOffset(10, 5)
        DropTitle.Size = UDim2.new(1, -20, 0, 18)
        DropTitle.Font = Enum.Font.GothamBold
        DropTitle.Text = Data.Title or Data.Name or "Dropdown"
        DropTitle.TextColor3 = TEXT
        DropTitle.TextSize = 12
        DropTitle.TextXAlignment = Enum.TextXAlignment.Left
        DropTitle.Parent = DropdownButton

        local SelectedText = Instance.new("TextLabel")
        SelectedText.BackgroundTransparency = 1
        SelectedText.Position = UDim2.fromOffset(10, 24)
        SelectedText.Size = UDim2.new(1, -20, 0, 18)
        SelectedText.Font = Enum.Font.Gotham
        SelectedText.Text = tostring(Selected or "Select...")
        SelectedText.TextColor3 = MUTED
        SelectedText.TextSize = 9
        SelectedText.TextXAlignment = Enum.TextXAlignment.Left
        SelectedText.Parent = DropdownButton

        local OptionFrame = Instance.new("Frame")
        OptionFrame.Name = "Options"
        OptionFrame.Position = UDim2.new(0, 0, 1, 4)
        OptionFrame.Size = UDim2.new(1, 0, 0, 0)
        OptionFrame.BackgroundColor3 = BACKGROUND
        OptionFrame.BorderSizePixel = 0
        OptionFrame.Visible = false
        OptionFrame.ZIndex = 50
        OptionFrame.Parent = Frame

        Corner(OptionFrame, 7)
        Stroke(OptionFrame, ACCENT, 1, 0.35)

        local OptionLayout = Instance.new("UIListLayout")
        OptionLayout.Padding = UDim.new(0, 3)
        OptionLayout.Parent = OptionFrame

        Padding(OptionFrame, 5, 5, 5, 5)

        local function SelectOption(Value)
            Selected = Value
            SelectedText.Text = tostring(Value)

            if typeof(Data.Callback) == "function" then
                task.spawn(Data.Callback, Value)
            end

            Open = false
            OptionFrame.Visible = false
            OptionFrame.Size = UDim2.new(1, 0, 0, 0)
        end

        for _, Value in ipairs(Options) do
            local Option = Instance.new("TextButton")
            Option.Size = UDim2.new(1, 0, 0, 28)
            Option.BackgroundColor3 = BUTTON
            Option.BorderSizePixel = 0
            Option.AutoButtonColor = false
            Option.Text = tostring(Value)
            Option.TextColor3 = TEXT
            Option.TextSize = 10
            Option.Font = Enum.Font.Gotham
            Option.ZIndex = 51
            Option.Parent = OptionFrame

            Corner(Option, 5)

            Option.MouseButton1Click:Connect(function()
                SelectOption(Value)
            end)
        end

        DropdownButton.MouseButton1Click:Connect(function()
            Open = not Open

            if Open then
                OptionFrame.Visible = true

                local count = #Options
                local height = math.min(170, (count * 31) + 10)

                Tween(OptionFrame, 0.15, {
                    Size = UDim2.new(1, 0, 0, height)
                })
            else
                Tween(OptionFrame, 0.15, {
                    Size = UDim2.new(1, 0, 0, 0)
                })

                task.delay(0.15, function()
                    if not Open then
                        OptionFrame.Visible = false
                    end
                end)
            end
        end)

        return {
            SetValue = function(_, Value)
                SelectOption(Value)
            end,

            GetValue = function()
                return Selected
            end
        }
    end

    --==================================================
    -- SLIDER
    --==================================================

    function Tab:AddSlider(Data)
        Data = Data or {}

        local Min = tonumber(Data.Min or Data.Minimum) or 0
        local Max = tonumber(Data.Max or Data.Maximum) or 100
        local Default = tonumber(Data.Default) or Min

        local Value = math.clamp(Default, Min, Max)

        local Frame = Instance.new("Frame")
        Frame.Size = UDim2.new(1, 0, 0, 62)
        Frame.BackgroundColor3 = BUTTON
        Frame.BorderSizePixel = 0
        Frame.Parent = Page

        Corner(Frame, 7)

        local SliderTitle = Instance.new("TextLabel")
        SliderTitle.BackgroundTransparency = 1
        SliderTitle.Position = UDim2.fromOffset(10, 6)
        SliderTitle.Size = UDim2.new(1, -70, 0, 18)
        SliderTitle.Font = Enum.Font.GothamBold
        SliderTitle.Text = Data.Title or Data.Name or "Slider"
        SliderTitle.TextColor3 = TEXT
        SliderTitle.TextSize = 12
        SliderTitle.TextXAlignment = Enum.TextXAlignment.Left
        SliderTitle.Parent = Frame

        local ValueLabel = Instance.new("TextLabel")
        ValueLabel.BackgroundTransparency = 1
        ValueLabel.AnchorPoint = Vector2.new(1, 0)
        ValueLabel.Position = UDim2.new(1, -10, 0, 6)
        ValueLabel.Size = UDim2.fromOffset(50, 18)
        ValueLabel.Font = Enum.Font.GothamBold
        ValueLabel.Text = tostring(Value)
        ValueLabel.TextColor3 = ACCENT
        ValueLabel.TextSize = 11
        ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
        ValueLabel.Parent = Frame

        local Bar = Instance.new("Frame")
        Bar.Position = UDim2.fromOffset(10, 37)
        Bar.Size = UDim2.new(1, -20, 0, 6)
        Bar.BackgroundColor3 = Color3.fromRGB(55, 40, 60)
        Bar.BorderSizePixel = 0
        Bar.Parent = Frame

        Corner(Bar, 4)

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new(
            (Value - Min) / math.max(Max - Min, 1),
            0,
            1,
            0
        )
        Fill.BackgroundColor3 = ACCENT
        Fill.BorderSizePixel = 0
        Fill.Parent = Bar

        Corner(Fill, 4)

        local Knob = Instance.new("Frame")
        Knob.AnchorPoint = Vector2.new(0.5, 0.5)
        Knob.Position = UDim2.new(
            (Value - Min) / math.max(Max - Min, 1),
            0,
            0.5,
            0
        )
        Knob.Size = UDim2.fromOffset(14, 14)
        Knob.BackgroundColor3 = TEXT
        Knob.BorderSizePixel = 0
        Knob.Parent = Bar

        Corner(Knob, 8)

        local Sliding = false

        local function SetSlider(NewValue)
            Value = math.clamp(NewValue, Min, Max)

            local Percent = (Value - Min) / math.max(Max - Min, 1)

            Fill.Size = UDim2.new(Percent, 0, 1, 0)
            Knob.Position = UDim2.new(Percent, 0, 0.5, 0)
            ValueLabel.Text = tostring(Value)

            if typeof(Data.Callback) == "function" then
                task.spawn(Data.Callback, Value)
            end
        end

        local function UpdateSlider(Input)
            local Percent = math.clamp(
                (Input.Position.X - Bar.AbsolutePosition.X)
                / Bar.AbsoluteSize.X,
                0,
                1
            )

            local NewValue = Min + ((Max - Min) * Percent)

            SetSlider(math.floor(NewValue + 0.5))
        end

        Bar.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1
                or Input.UserInputType == Enum.UserInputType.Touch then

                Sliding = true
                UpdateSlider(Input)
            end
        end)

        UserInputService.InputChanged:Connect(function(Input)
            if Sliding and (
                Input.UserInputType == Enum.UserInputType.MouseMovement
                or Input.UserInputType == Enum.UserInputType.Touch
            ) then
                UpdateSlider(Input)
            end
        end)

        UserInputService.InputEnded:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1
                or Input.UserInputType == Enum.UserInputType.Touch then

                Sliding = false
            end
        end)

        return {
            SetValue = function(_, NewValue)
                SetSlider(tonumber(NewValue) or Min)
            end,

            GetValue = function()
                return Value
            end
        }
    end

    --==================================================
    -- SEPARATORS
    --==================================================

    function Tab:AddSeperator()
        local Line = Instance.new("Frame")
        Line.Size = UDim2.new(1, 0, 0, 1)
        Line.BackgroundColor3 = ACCENT
        Line.BackgroundTransparency = 0.5
        Line.BorderSizePixel = 0
        Line.Parent = Page

        return Line
    end

    function Tab:AddSeparator()
        return Tab:AddSeperator()
    end

    function Tab:AddLine()
        return Tab:AddSeperator()
    end

    table.insert(Tabs, Tab)

    if not CurrentTab then
        Select()
    end

    return Tab
end

