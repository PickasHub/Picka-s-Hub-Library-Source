    --==================================================
    -- SELECT TAB
    --==================================================

    local function Select()
        for _, Existing in ipairs(Tabs) do
            Existing.Page.Visible = false
            Existing.Button.BackgroundTransparency = 1

            local txt = Existing.Button:FindFirstChildOfClass("TextLabel")
            if txt then
                txt.TextColor3 = MUTED
            end

            local img = Existing.Button:FindFirstChild("Icon")
            if img then
                img.ImageColor3 = MUTED
            end
        end

        Page.Visible = true
        TabButton.BackgroundTransparency = 0

        Tween(TabButton, 0.15, {
            BackgroundColor3 = ACCENT
        })

        TabText.TextColor3 = Color3.new(1, 1, 1)

        if Icon then
            Icon.ImageColor3 = Color3.new(1, 1, 1)
        end

        CurrentTab = Tab
    end

    TabButton.MouseButton1Click:Connect(Select)

