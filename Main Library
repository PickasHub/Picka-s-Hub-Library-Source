            function Item:AddDropdown(Config)
                Config = Config or {}

                local Options = Config.Options or {}
                local Multi = Config.Multi == true
                local Selected = {}

                local Holder = Create("Frame", {
                    BackgroundColor3 = Theme.Button,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 42),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    LayoutOrder = #Items:GetChildren(),
                    ZIndex = 20
                }, Items)

                MakeCorner(Holder, 7)

                local Header = Create("TextButton", {
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    Size = UDim2.new(1, 0, 0, 42),
                    ZIndex = 21
                }, Holder)

                local Label = Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Text = Config.Name or "Dropdown",
                    TextColor3 = Theme.Text,
                    TextSize = 11,
                    Font = Enum.Font.GothamMedium,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Position = UDim2.fromOffset(12, 0),
                    Size = UDim2.new(1, -50, 1, 0),
                    ZIndex = 22
                }, Header)

                local Arrow = Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Text = "⌄",
                    TextColor3 = Theme.AccentLight,
                    TextSize = 15,
                    Font = Enum.Font.GothamBold,
                    Position = UDim2.new(1, -35, 0, 0),
                    Size = UDim2.fromOffset(25, 42),
                    ZIndex = 22
                }, Header)

                local OptionsHolder = Create("Frame", {
                    BackgroundTransparency = 1,
                    Position = UDim2.fromOffset(8, 42),
                    Size = UDim2.new(1, -16, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Visible = false,
                    ZIndex = 22
                }, Holder)

                local Search = Create("TextBox", {
                    BackgroundColor3 = Theme.Background,
                    BorderSizePixel = 0,
                    PlaceholderText = "Search...",
                    PlaceholderColor3 = Theme.SubText,
                    Text = "",
                    TextColor3 = Theme.Text,
                    TextSize = 10,
                    Font = Enum.Font.Gotham,
                    ClearTextOnFocus = false,
                    Position = UDim2.fromOffset(0, 3),
                    Size = UDim2.new(1, 0, 0, 30),
                    ZIndex = 24
                }, OptionsHolder)

                MakeCorner(Search, 6)

                local OptionList = Create("UIListLayout", {
                    Padding = UDim.new(0, 4),
                    SortOrder = Enum.SortOrder.LayoutOrder
                }, OptionsHolder)

                local SearchPadding = Create("UIPadding", {
                    PaddingBottom = UDim.new(0, 6)
                }, OptionsHolder)

                local OptionObjects = {}

                local DropdownAPI = {}

                local function UpdateDisplay()
                    local Values = {}

                    for Value, Active in pairs(Selected) do
                        if Active then
                            table.insert(Values, tostring(Value))
                        end
                    end

                    if #Values == 0 then
                        Label.Text = Config.Name or "Dropdown"
                    elseif Multi then
                        Label.Text = (Config.Name or "Dropdown") ..
                            ": " .. table.concat(Values, ", ")
                    else
                        Label.Text = (Config.Name or "Dropdown") ..
                            ": " .. Values[1]
                    end
                end

                local function Callback()
                    if Config.Callback then
                        if Multi then
                            local Values = {}

                            for Value, Active in pairs(Selected) do
                                if Active then
                                    table.insert(Values, Value)
                                end
                            end

                            task.spawn(function()
                                Config.Callback(Values)
                            end)
                        else
                            local Value

                            for Option, Active in pairs(Selected) do
                                if Active then
                                    Value = Option
                                    break
                                end
                            end

                            task.spawn(function()
                                Config.Callback(Value)
                            end)
                        end
                    end
                end

                local function SelectOption(Value)
                    if Multi then
                        Selected[Value] = not Selected[Value]
                    else
                        Selected = {
                            [Value] = true
                        }
                    end

                    for OptionValue, Object in pairs(OptionObjects) do
                        if Selected[OptionValue] then
                            Tween(Object, 0.15, {
                                BackgroundColor3 = Theme.AccentDark,
                                BackgroundTransparency = 0
                            })

                            Object.TextColor3 = Theme.Text
                        else
                            Tween(Object, 0.15, {
                                BackgroundColor3 = Theme.Background,
                                BackgroundTransparency = 0.35
                            })

                            Object.TextColor3 = Theme.SubText
                        end
                    end

                    UpdateDisplay()
                    Callback()

                    if not Multi then
                        OptionsHolder.Visible = false
                        Arrow.Text = "⌄"
                    end
                end

                for Index, Value in ipairs(Options) do
                    local Option = Create("TextButton", {
                        Name = "Option",
                        BackgroundColor3 = Theme.Background,
                        BackgroundTransparency = 0.35,
                        BorderSizePixel = 0,
                        Text = tostring(Value),
                        TextColor3 = Theme.SubText,
                        TextSize = 10,
                        Font = Enum.Font.GothamMedium,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Size = UDim2.new(1, 0, 0, 30),
                        LayoutOrder = Index,
                        AutoButtonColor = false,
                        ZIndex = 25
                    }, OptionsHolder)

                    MakeCorner(Option, 6)
                    MakePadding(Option, 10, 5, 0, 0)

                    OptionObjects[Value] = Option

                    Option.Activated:Connect(function()
                        Ripple(Option)
                        SelectOption(Value)
                    end)
                end

                local function ApplySearch()
                    local Query = string.lower(Search.Text)

                    for Value, Object in pairs(OptionObjects) do
                        local Match = string.find(
                            string.lower(tostring(Value)),
                            Query,
                            1,
                            true
                        )

                        Object.Visible = Query == "" or Match ~= nil
                    end
                end

                Search:GetPropertyChangedSignal("Text"):Connect(ApplySearch)

                Header.Activated:Connect(function()
                    Ripple(Header)

                    OptionsHolder.Visible = not OptionsHolder.Visible
                    Arrow.Text = OptionsHolder.Visible and "⌃" or "⌄"
                end)

                function DropdownAPI:Set(Value)
                    Selected = {}

                    if Multi and type(Value) == "table" then
                        for _, ItemValue in ipairs(Value) do
                            Selected[ItemValue] = true
                        end
                    else
                        Selected[Value] = true
                    end

                    for OptionValue, Object in pairs(OptionObjects) do
                        if Selected[OptionValue] then
                            Object.BackgroundColor3 = Theme.AccentDark
                            Object.BackgroundTransparency = 0
                            Object.TextColor3 = Theme.Text
                        else
                            Object.BackgroundColor3 = Theme.Background
                            Object.BackgroundTransparency = 0.35
                            Object.TextColor3 = Theme.SubText
                        end
                    end

                    UpdateDisplay()
                end

                function DropdownAPI:Clear()
                    Selected = {}

                    for _, Object in pairs(OptionObjects) do
                        Object.BackgroundColor3 = Theme.Background
                        Object.BackgroundTransparency = 0.35
                        Object.TextColor3 = Theme.SubText
                    end

                    UpdateDisplay()
                end

                function DropdownAPI:AddOption(Value)
                    if OptionObjects[Value] then
                        return
                    end

                    local Option = Create("TextButton", {
                        Name = "Option",
                        BackgroundColor3 = Theme.Background,
                        BackgroundTransparency = 0.35,
                        BorderSizePixel = 0,
                        Text = tostring(Value),
                        TextColor3 = Theme.SubText,
                        TextSize = 10,
                        Font = Enum.Font.GothamMedium,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Size = UDim2.new(1, 0, 0, 30),
                        AutoButtonColor = false,
                        ZIndex = 25
                    }, OptionsHolder)

                    MakeCorner(Option, 6)
                    MakePadding(Option, 10, 5, 0, 0)

                    OptionObjects[Value] = Option

                    Option.Activated:Connect(function()
                        Ripple(Option)
                        SelectOption(Value)
                    end)
                end

                function DropdownAPI:Refresh(NewOptions)
                    for _, Object in pairs(OptionObjects) do
                        if Object then
                            Object:Destroy()
                        end
                    end

                    OptionObjects = {}

                    for Index, Value in ipairs(NewOptions or {}) do
                        local Option = Create("TextButton", {
                            Name = "Option",
                            BackgroundColor3 = Theme.Background,
                            BackgroundTransparency = 0.35,
                            BorderSizePixel = 0,
                            Text = tostring(Value),
                            TextColor3 = Theme.SubText,
                            TextSize = 10,
                            Font = Enum.Font.GothamMedium,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            Size = UDim2.new(1, 0, 0, 30),
                            LayoutOrder = Index,
                            AutoButtonColor = false,
                            ZIndex = 25
                        }, OptionsHolder)

                        MakeCorner(Option, 6)
                        MakePadding(Option, 10, 5, 0, 0)

                        OptionObjects[Value] = Option

                        Option.Activated:Connect(function()
                            Ripple(Option)
                            SelectOption(Value)
                        end)
                    end

                    Selected = {}
                    UpdateDisplay()
                end

                if Config.Default ~= nil then
                    DropdownAPI:Set(Config.Default)
                end

                return DropdownAPI
            end

            return Item
        end

        return Sections
    end

    Window.Tabs = Tabs

    return Window
end

