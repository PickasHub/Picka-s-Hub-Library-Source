		BackgroundTransparency = 1,

		BorderSizePixel = 0,

		Text = "",

		AutoButtonColor = false,

		ZIndex = 151

	}, holder)

	Create("TextLabel", {

		Position =
			UDim2.fromOffset(12, 4),

		Size =
			UDim2.new(1, -40, 0, 18),

		BackgroundTransparency = 1,

		Text =
			tostring(
				title or "Dropdown"
			),

		TextColor3 = TEXT,

		TextSize = 12,

		Font =
			Enum.Font.GothamBold,

		TextXAlignment =
			Enum.TextXAlignment.Left,

		ZIndex = 152

	}, mainButton)

	local selectedText = Create("TextLabel", {

		Position =
			UDim2.fromOffset(12, 22),

		Size =
			UDim2.new(1, -40, 0, 15),

		BackgroundTransparency = 1,

		Text =
			tostring(
				content or ""
			),

		TextColor3 = SUBTEXT,

		TextSize = 9,

		Font =
			Enum.Font.Gotham,

		TextXAlignment =
			Enum.TextXAlignment.Left,

		ZIndex = 152

	}, mainButton)

	local arrow = Create("TextLabel", {

		AnchorPoint =
			Vector2.new(1, 0.5),

		Position =
			UDim2.new(1, -10, 0, 22),

		Size =
			UDim2.fromOffset(20, 20),

		BackgroundTransparency = 1,

		Text = "›",

		TextColor3 = TEXT,

		TextSize = 18,

		Font =
			Enum.Font.GothamBold,

		ZIndex = 152

	}, mainButton)

	local optionHolder = Create("Frame", {

		Name = "Options",

		Position =
			UDim2.fromOffset(8, 48),

		Size =
			UDim2.new(1, -16, 0, 0),

		BackgroundTransparency = 1,

		BorderSizePixel = 0,

		ZIndex = 153

	}, holder)

	Create("UIListLayout", {

		Padding =
			UDim.new(0, 4)

	}, optionHolder)

	local function UpdateText()

		if #current == 0 then

			selectedText.Text =
				tostring(
					content or ""
				)

		else

			selectedText.Text =
				table.concat(
					current,
					", "
				)

		end

	end

	UpdateText()

	for _, option in ipairs(options or {}) do

		local optionButton = Create("TextButton", {

			Size =
				UDim2.new(1, 0, 0, 30),

			BackgroundColor3 =
				BACKGROUND,

			BorderSizePixel = 0,

			Text =
				tostring(option),

			TextColor3 =
				TEXT,

			TextSize = 10,

			Font =
				Enum.Font.Gotham,

			AutoButtonColor = false,

			ZIndex = 154

		}, optionHolder)

		AddCorner(optionButton, 7)

		optionButton.MouseButton1Click:Connect(function()

			if multi then

				local index =
					table.find(
						current,
						option
					)

				if index then

					table.remove(
						current,
						index
					)

				else

					table.insert(
						current,
						option
					)

				end

			else

				current = {
					option
				}

				opened = false

				PlayTween(
					holder,
					0.2,
					{
						Size =
							UDim2.new(
								1,
								0,
								0,
								44
							)
					}
				)

				PlayTween(
					arrow,
					0.15,
					{
						Rotation = 0
					}
				)

			end

			UpdateText()

			if typeof(callback) ==
				"function" then

				task.spawn(
					callback,
					current
				)

			end

		end)

	end

	mainButton.MouseButton1Click:Connect(function()

		opened = not opened

		if opened then

			local count =
				#(options or {})

			local height =
				math.clamp(
					count * 34 + 8,
					40,
					180
				)

			PlayTween(
				holder,
				0.2,
				{
					Size =
						UDim2.new(
							1,
							0,
							0,
							52 + height
						)
				}
			)

			PlayTween(
				arrow,
				0.15,
				{
					Rotation = 90
				}
			)

		else

			PlayTween(
				holder,
				0.2,
				{
					Size =
						UDim2.new(
							1,
							0,
							0,
							44
						)
				}
			)

			PlayTween(
				arrow,
				0.15,
				{
					Rotation = 0
				}
			)

		end

	end)

	return {

		SetValue = function(_, value)

			if type(value) ==
				"table" then

				current = value

			else

				current = {
					value
				}

			end

			UpdateText()

		end,

		GetValue = function()

			return current

		end

	}

end

