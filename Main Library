--==================================================
-- MINIMIZE / RESTORE
--==================================================

local Minimized = false

local LastSize = Vector2.new(
    DEFAULT_WIDTH,
    DEFAULT_HEIGHT
)

local function Minimize()

    if Minimized then
        return
    end

    Minimized = true

    LastSize = WindowHolder.AbsoluteSize

    Tween(WindowHolder, 0.22, {
        Size = UDim2.fromOffset(0, 0)
    })

    task.delay(0.18, function()

        Main.Visible = false

        FloatingButton.Visible = true

        FloatingButton.Size = UDim2.fromOffset(0, 0)

        Tween(FloatingButton, 0.25, {
            Size = UDim2.fromOffset(60, 60)
        })

    end)

end

local function Restore()

    if not Minimized then
        return
    end

    Minimized = false

    Tween(FloatingButton, 0.18, {
        Size = UDim2.fromOffset(0, 0)
    })

    task.delay(0.18, function()

        FloatingButton.Visible = false

        Main.Visible = true

        WindowHolder.Size = UDim2.fromOffset(
            math.clamp(
                LastSize.X,
                MIN_WIDTH,
                MAX_WIDTH
            ),

            math.clamp(
                LastSize.Y,
                MIN_HEIGHT,
                MAX_HEIGHT
            )
        )

        Main.BackgroundTransparency = 1

        Tween(Main, 0.22, {
            BackgroundTransparency = WINDOW_TRANSPARENCY
        })

    end)

end

MinimizeButton.MouseButton1Click:Connect(Minimize)

FloatingButton.MouseButton1Click:Connect(Restore)

